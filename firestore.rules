rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Secure Admin check:
    // 1. Document exists in /admins/{uid}
    // 2. OR user document in /users/{uid} has role == 'admin'
    // 3. OR exact verified admin emails (suyabamins@gmail.com, automated persistence runner)
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'suyabamins@gmail.com' ||
          request.auth.token.email.lower() == 'admin-persistence-test@shibir.library'
        ))
      );
    }

    // 1. Categories: Anyone can read, Admin can manage
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Digital Books: Anyone can read, Admin can create/edit/delete
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Physical Books & Inventory: Anyone can read availability, Admin can manage
    match /physicalBooks/{physicalBookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookCopies/{copyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. History Articles: Anyone can read, Admin can publish
    match /historyArticles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. User Profiles:
    // - Authenticated users can read profiles (needed for borrower names, chat, admin list)
    // - Users can create their own profile during registration
    // - Users can update their own profile; Admin can update/delete any profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Borrow Requests:
    // - Authenticated users can create borrow requests with their own UID
    // - Borrower and Admin can view & update request status
    match /borrowRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.borrowerUid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.borrowerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 7. Loans & Return Confirmations:
    // - Authenticated users can view loans
    // - Borrower & Admin can update return confirmation timestamps
    match /loans/{loanId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.borrowerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 8. Real-time Chats & Messages:
    // - Authenticated participants can view conversations and send messages
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 9. Notifications:
    // - Recipient can read and update read status
    // - System/Auth users can create notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 10. Admins Registry:
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Audit Logs:
    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // 12. Site Content & Settings (Visual CMS):
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Dynamic Syllabus Management:
    // - Public visitors can read only published syllabuses (status == 'published')
    // - Authorized admins can read all (including drafts) and create/update/delete
    match /syllabuses/{syllabusId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
  }
}
