# ==========================================
# Frontend Configuration (Public / Safe)
# ==========================================
VITE_APP_NAME="শিবির লাইব্রেরি, UIU থানা"
VITE_APP_TAGLINE="শহিদি কাফেলা"

# Firebase Client Configuration (Spark/Blaze)
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="shibir-library-uiu.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="shibir-library-uiu"
VITE_FIREBASE_STORAGE_BUCKET="shibir-library-uiu.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Cloudflare R2 Public CDN / Domain (Optional if read via presigned/worker)
VITE_R2_PUBLIC_URL=""

# ==========================================
# Backend / Server-side Secrets ONLY
# (DO NOT expose in client bundle or prefix with VITE_)
# ==========================================
# Cloudflare Pages Functions / Workers Environment:
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="shibir-library-bucket"
# FIREBASE_PROJECT_ID="shibir-library-uiu"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@shibir-library-uiu.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
